{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.leshchenko1979/fast-mcp-telegram",
  "description": "Multi-tenant Telegram gateway for AI agents — HTTP+stdio, 8 tools, MTProto User API",
  "version": "0.44.1",
  "websiteUrl": "https://github.com/leshchenko1979/fast-mcp-telegram",
  "repository": {
    "url": "https://github.com/leshchenko1979/fast-mcp-telegram",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "fast-mcp-telegram",
      "version": "0.44.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_ID",
          "description": "Telegram API ID from my.telegram.org",
          "isRequired": true
        },
        {
          "name": "API_HASH",
          "description": "Telegram API Hash from my.telegram.org",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "SERVER_MODE",
          "description": "Server mode: stdio (local), http-no-auth (dev), http-auth (prod)",
          "default": "stdio"
        },
        {
          "name": "SESSION_DIR",
          "description": "Custom session directory (defaults to ~/.config/fast-mcp-telegram/)"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://tg-mcp.l1979.ru/v1/mcp"
    }
  ]
}
